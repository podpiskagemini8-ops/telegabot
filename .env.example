# Токен вашего бота от @BotFather
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Telegram ID администраторов через запятую (эти пользователи имеют доступ к /admin и кнопке "Узнать кто это")
# Пример: ADMIN_IDS=123456789,987654321
ADMIN_IDS=

# Путь к файлу базы данных
DB_PATH=database.sqlite3

# Google Gemini API Key для генерации изображений Nano Banana 2
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
